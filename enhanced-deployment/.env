# =============================================================================
# Environment Configuration File
# =============================================================================

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=catalog_user
DB_PASSWORD=catalog_pass
DB_NAME=telepath_catalog
DB_ROOT_PASSWORD=root_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Catalog Manager Configuration
CATALOG_MANAGER_HOST=0.0.0.0
CATALOG_MANAGER_PORT=8080
CATALOG_MANAGER_URL=http://catalog-manager:8080

# MCP Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8081
MCP_SERVER_NAME=telepath-enhanced

# Application Environment
FLASK_ENV=development
FLASK_DEBUG=1
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# Network Configuration
NETWORK_SUBNET=172.20.0.0/16