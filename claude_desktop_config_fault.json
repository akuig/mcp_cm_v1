{
  "mcpServers": {
    "telepath-fault": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--network", "host",
        "-e", "CATALOG_MANAGER_URL=http://localhost:8080",
        "-e", "FAULT_MANAGER_URL=http://localhost:8081",
        "telepath-mcp:latest",
        "python", "/app/mcp_stdio_server_fault.py"
      ],
      "description": "Telepath AI MCP Server with Fault Management",
      "metadata": {
        "tools": [
          "service_qualification",
          "customer_management",
          "product_ordering",
          "service_activation",
          "check_service_status",
          "create_trouble_ticket",
          "execute_remedial_action",
          "get_service_problems"
        ]
      }
    }
  }
}
