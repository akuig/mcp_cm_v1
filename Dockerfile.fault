FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements file
COPY requirements_fault.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements_fault.txt

# Copy application code
COPY fault_manager.py .

# Expose port
EXPOSE 8081

# Run the application
CMD ["python", "fault_manager.py"]
