FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements_fault.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements_fault.txt

# Copy application code
COPY fault_manager.py .

# Create non-root user
RUN useradd -m -u 1000 faultuser && chown -R faultuser:faultuser /app
USER faultuser

# Expose Fault Manager port
EXPOSE 8081

# Run the Flask app
CMD ["python", "-u", "fault_manager.py"]
