FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements_mcp.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements_mcp.txt

# Copy all MCP server files
COPY mcp_fastmcp_server.py .
COPY mcp_fastmcp_server_with_fault.py .

# Create non-root user
RUN useradd -m -u 1000 mcpuser && chown -R mcpuser:mcpuser /app
USER mcpuser

# Expose MCP server port
EXPOSE 8090

# Default to original server, but allow override via command
CMD ["python", "-u", "mcp_fastmcp_server.py"]
