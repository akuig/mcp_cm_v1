# Dockerfile for Enhanced Catalog Manager
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy all application files
COPY . .

# Ensure the enhanced catalog manager is used
# If you have separate files, make sure to copy the right one
COPY catalog_manager_enhanced.py catalog_manager.py

# Create data directory for persistence (optional)
RUN mkdir -p /app/data

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8080/health')" || exit 1

# Run the enhanced catalog manager
CMD ["python", "catalog_manager.py"]
